# Credenciales de la API del LLM. Copiar a `.env` (ignorado por git) y rellenar.
# El backend openai de ai/model_adapter.py lee estas tres variables.
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a && .venv/bin/python -m ai.run_pilot ...
#
# Modelos vigentes de la API (GET https://api.deepseek.com/models):
#   deepseek-v4-flash  — $0.14/M in · $0.28/M out · $0.028/M cache read
#   deepseek-v4-pro    — $1.74/M in · $3.48/M out · $0.145/M cache read
# OJO: ambos son modelos de RAZONAMIENTO (thinkingFormat deepseek). Verificar
# que `content` no vuelva vacío con el max_tokens que use el llamador — es el
# defecto que ya descartó a qwen3:4b (13/08).
WORLDLAB_LLM_API_KEY=sk-...
WORLDLAB_LLM_BASE_URL=https://api.deepseek.com/v1
WORLDLAB_LLM_MODEL=deepseek-v4-flash
